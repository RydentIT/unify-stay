{
  "name": "unify-stay-frontend",
  "private": true,
  "version": "0.0.0",
  "description": "Turborepo workspace holding the UnifyStay user and admin portals.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "e2e:install": "playwright install --with-deps chromium",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "rimraf": "6.1.3",
    "turbo": "2.10.11",
    "typescript": "5.9.3"
  }
}
