# Copy to .env.local for local development. Never commit .env.local.
#
# Base URL of the UnifyStay backend API. NEXT_PUBLIC_ values are inlined into the client
# bundle, so this must never hold a secret.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional. Shown in the UI so staff can tell which environment they are operating on -
# worth setting explicitly for anything that is not local.
NEXT_PUBLIC_ENVIRONMENT_NAME=local
