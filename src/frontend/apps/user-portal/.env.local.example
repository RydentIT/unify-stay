# Copy to .env.local for local development. Never commit .env.local.
#
# Base URL of the UnifyStay backend API. NEXT_PUBLIC_ is required because the browser
# calls the API directly; anything under this prefix is inlined into the client bundle,
# so it must never hold a secret.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Optional. Shown in the UI and useful for telling environments apart at a glance.
NEXT_PUBLIC_ENVIRONMENT_NAME=local
