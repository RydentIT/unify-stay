{
  "//": [
    "Placeholders only. Real values are supplied by the environment - see .env.example.",
    "Nothing secret is ever committed to this file. Env var names use the ASP.NET Core",
    "double-underscore convention, e.g. Jwt__SigningKey overrides Jwt:SigningKey."
  ],
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Unify": ""
  },
  "Database": {
    "ConnectionString": "",
    "RunMigrationsOnStartup": false,
    "CommandTimeoutSeconds": 30
  },
  "Jwt": {
    "Issuer": "",
    "Audience": "",
    "SigningKey": "",
    "AccessTokenLifetimeMinutes": 60,
    "PasswordChangeTokenLifetimeMinutes": 10,
    "ClockSkewSeconds": 30
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "Registration": { "PermitLimit": 5, "WindowMinutes": 15 },
    "Login": { "PermitLimit": 10, "WindowMinutes": 15 },
    "PasswordReset": { "PermitLimit": 3, "WindowMinutes": 60 },
    "Global": { "PermitLimit": 300, "WindowMinutes": 1 }
  }
}
