# ---------------------------------------------------------------------------
# UnifyStay - local environment template
#
# Copy to .env (which is gitignored) and adjust. docker compose reads .env
# automatically. EVERY value here is a dummy - never commit real credentials.
#
# ASP.NET Core maps double underscores to configuration nesting, so
# Jwt__SigningKey overrides the "Jwt:SigningKey" key. That is why the API
# needs no config file changes between environments.
# ---------------------------------------------------------------------------

# ---------- Postgres (used by the postgres service and by the API) ----------
POSTGRES_DB=unify
POSTGRES_USER=unify
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432

# ---------- API ----------
ASPNETCORE_ENVIRONMENT=Development
API_PORT=5000

# Host=postgres matches the compose service name. Change to localhost when running
# the API outside compose.
ConnectionStrings__Unify=Host=postgres;Port=5432;Database=unify;Username=unify;Password=change-me-locally

# Applies pending migrations from database/sql/ during startup. Development only -
# elsewhere run scripts/migrate.sh (or migrate.ps1) as a deploy step instead.
Database__RunMigrationsOnStartup=true

# JWT. SigningKey must be at least 32 bytes for HS256; generate a real one with
#   openssl rand -base64 48
Jwt__Issuer=https://localhost:5000
Jwt__Audience=unify-stay
Jwt__SigningKey=dummy-development-signing-key-at-least-32-bytes-long
Jwt__AccessTokenLifetimeMinutes=60
Jwt__PasswordChangeTokenLifetimeMinutes=10

# Browser origins allowed to call the API.
Cors__AllowedOrigins__0=http://localhost:3000
Cors__AllowedOrigins__1=http://localhost:3001

# Rate limits (requests per window, per caller).
RateLimiting__Registration__PermitLimit=5
RateLimiting__Registration__WindowMinutes=15
RateLimiting__Login__PermitLimit=10
RateLimiting__Login__WindowMinutes=15
RateLimiting__PasswordReset__PermitLimit=3
RateLimiting__PasswordReset__WindowMinutes=60

# ---------- Email ----------
# No provider is wired yet: Infrastructure ships a logging IEmailSender that writes
# the message to the log instead of sending it. These are placeholders for when a
# provider is chosen along with the cloud target.
Email__Provider=logging
Email__FromAddress=no-reply@unifystay.local
Email__FromName=UnifyStay
# Email__SmtpHost=
# Email__SmtpPort=587
# Email__SmtpUsername=
# Email__SmtpPassword=
# Email__ApiKey=

# ---------- Frontend ----------
# NEXT_PUBLIC_* is inlined into the browser bundle at BUILD time, so compose passes
# it as a build arg. It must never hold a secret.
NEXT_PUBLIC_API_URL=http://localhost:5000
USER_PORTAL_PORT=3000
ADMIN_PORTAL_PORT=3001
